<!doctype html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{% block title %}recht-zeitig{% endblock %} · recht-zeitig</title>
    <style>
        :root { --ink: #1d2430; --muted: #5d6675; --line: #e3e6ea; --accent: #0b6e8a; --bg: #fbfaf7; --card: #fff; }
        @media (prefers-color-scheme: dark) {
            :root { --ink: #e8eaed; --muted: #a1a8b3; --line: #2e3440; --accent: #5cc3df; --bg: #14181f; --card: #1b2029; }
        }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--bg); color: var(--ink); font: 17px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif; }
        header, main, footer { max-width: 46rem; margin: 0 auto; padding: 0 1rem; }
        header { display: flex; justify-content: space-between; align-items: baseline; padding-top: 1.5rem; }
        .logo { font-weight: 700; font-size: 1.25rem; color: var(--ink); text-decoration: none; letter-spacing: -.01em; }
        .logo span { color: var(--accent); }
        nav a { color: var(--muted); margin-left: 1rem; text-decoration: none; font-size: .95rem; }
        nav a:hover, a { color: var(--accent); }
        main { padding-top: 2rem; padding-bottom: 3rem; }
        h1 { font-size: 2rem; line-height: 1.2; letter-spacing: -.02em; }
        .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 1.25rem 1.5rem; margin: 1.5rem 0; }
        .meta { color: var(--muted); font-size: .9rem; }
        code { font-size: .88em; overflow-wrap: anywhere; }
        dl { display: grid; grid-template-columns: max-content 1fr; gap: .35rem 1rem; margin: 0; }
        dt { color: var(--muted); }
        dd { margin: 0; }
        footer { border-top: 1px solid var(--line); padding: 1.25rem 1rem 2rem; color: var(--muted); font-size: .9rem; }
        footer a { color: var(--muted); margin-right: 1rem; }
        .legal h1 { font-size: 1.75rem; }
        .legal h2 { font-size: 1.25rem; margin-top: 2rem; }
        .legal h3 { font-size: 1.05rem; }
    </style>
</head>
<body>
<header>
    <a class="logo" href="{{ path('home') }}">recht-<span>zeitig</span></a>
    <nav>
        <a href="{{ path('imprint_de') }}">Impressum</a>
        <a href="{{ path('privacy_de') }}">Datenschutz</a>
        <a href="{{ path('imprint_en') }}" hreflang="en">EN</a>
    </nav>
</header>
<main>{% block body %}{% endblock %}</main>
<footer>
    <a href="{{ path('imprint_de') }}">Impressum</a>
    <a href="{{ path('privacy_de') }}">Datenschutz</a>
    <a href="{{ path('imprint_en') }}" hreflang="en">Imprint</a>
    <a href="{{ path('privacy_en') }}" hreflang="en">Privacy Policy</a>
</footer>
</body>
</html>
